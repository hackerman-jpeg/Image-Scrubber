#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
UPDATE=0
if [[ "${1:-}" == "--update" ]]; then
    UPDATE=1
    shift
fi

# Isolate dependencies from system Python and the caller's active environment.
if [[ ! -x "$SCRIPT_DIR/.venv/bin/python3" || ! -f "$SCRIPT_DIR/.venv/.ready" || "$UPDATE" == 1 ]]; then
    if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))'; then
        echo 'Python 3.10+ is required: https://www.python.org/downloads/macos/' >&2
        exit 1
    fi
    echo 'Installing image libraries locally. No images are uploaded.'
    python3 -m venv "$SCRIPT_DIR/.venv"
    rm -f "$SCRIPT_DIR/.venv/.ready"
    "$SCRIPT_DIR/.venv/bin/python3" -I -m pip install --upgrade \
        --disable-pip-version-check --no-cache-dir -r "$SCRIPT_DIR/requirements.txt"
    touch "$SCRIPT_DIR/.venv/.ready"
fi

if [[ "$UPDATE" == 1 && "$#" == 0 ]]; then
    echo 'Image libraries updated.'
    exit 0
fi

exec "$SCRIPT_DIR/.venv/bin/python3" -I -B "$SCRIPT_DIR/main_entry.py" "$@"
